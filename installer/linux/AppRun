#!/bin/sh
# The AppImage's entry point. One AppImage holds UDM's five programs:
#
#   UDM.AppImage                    the window
#   UDM.AppImage udm-daemon         a program by name (UDM starts its
#                                   other programs this way)
#   UDM.AppImage udm-cli get URL    the command-line tool
#   UDM.AppImage udm-mcp            the AI assistants' server
#   UDM.AppImage chrome-extension://…  a browser starting the native host
#   UDM.AppImage <manifest> udm@udm.local  Firefox starting it
HERE="$(dirname "$(readlink -f "$0")")"
BIN="$HERE/usr/bin"
case "$1" in
  udm-gui|udm-daemon|udm-host|udm-cli|udm-mcp)
    prog="$1"
    shift
    exec "$BIN/$prog" "$@"
    ;;
  chrome-extension://*)
    exec "$BIN/udm-host" "$@"
    ;;
esac
if [ "$2" = "udm@udm.local" ]; then
  exec "$BIN/udm-host" "$@"
fi
exec "$BIN/udm-gui" "$@"
